{
  "inputs": [
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Collection URL for on-prem (e.g. 'https://your-server/tfs/YourCollection') or organization name for the cloud service"
    }
  ],
  "servers": {
    "ado": {
      "type": "stdio",
      "command": "mcp-server-azuredevops",
      "args": ["${input:ado_org}"],
      "env": {
        "LOG_LEVEL": "debug",
        "NODE_OPTIONS": "--use-system-ca"
      }
    }
  }
}
